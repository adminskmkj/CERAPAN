# Salin ke .env.local (dev) atau Vercel → Settings → Environment Variables (production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server sahaja — jangan dedahkan ke client (untuk cipta pengguna & API pentadbir)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key